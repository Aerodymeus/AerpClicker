<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="dev.aerodymeus.aerpclicker">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/aerp_button"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/aerp_button_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AerpClicker">
        <activity
            android:name="dev.aerodymeus.aerpclicker.ui.UI"
            android:exported="true"
            android:theme="@style/Theme.AerpClicker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

    <queries>
        <!-- Erlaube der App, nach Apps zu suchen, die E-Mails versenden können -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

</manifest>

